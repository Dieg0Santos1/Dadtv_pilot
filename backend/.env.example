# Demo local: no contacta Supabase ni Wamundo, no cobra a clientes.
BOT_MODE=demo
BOT_ENGINE=rules
# El clasificador APF3 entrenado decide las consultas libres; no confirma pagos.
BOT_INTENT_MODEL_ENABLED=true
BOT_INTENT_CONFIDENCE_THRESHOLD=0.45
BOT_INTENT_MARGIN_THRESHOLD=0.15
BOT_PROVIDER=wasender
BOT_DATABASE_PATH=data/bot.sqlite3
ADMIN_API_TOKEN=
BOT_SEND_ENABLED=false
BOT_COMMERCE_ENABLED=false
BOT_RENEWAL_ENABLED=false
BOT_TEST_CONTACTS_ONLY=true
# Remitentes permitidos, con código de país, separados por coma.
BOT_ALLOWED_PHONES=
SUPPORT_ALERT_PHONE=

# Para staging conectado a la misma estructura de DadTvStore.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TENANT_ID=
STORE_URL=https://dadtvplay.com
# Mantener estos datos iguales a los de la recarga automática de la tienda.
RECHARGE_YAPE_PHONE=
RECHARGE_RECEIVER=
RECHARGE_MIN_AMOUNT=20
RECHARGE_WINDOW_MINUTES=10
BOT_WHATSAPP_RECHARGE_ENABLED=false

# Cuenta existente de WaSender (el número del negocio).
WASENDER_API_TOKEN=
WASENDER_WEBHOOK_SECRET=
WASENDER_ACCOUNT_PHONE=51900000001

# Alternativa: Wamundo con BOT_PROVIDER=wamundo.
WAMUNDO_SECRET=
WAMUNDO_ACCOUNT_ID=
WAMUNDO_HOOK_TOKEN=
WAMUNDO_WEBHOOK_SECRET=
WAMUNDO_ACCOUNT_WID=
POLL_INTERVAL_SECONDS=30
DEBOUNCE_SECONDS=3
MAX_MESSAGE_AGE_SECONDS=600

# BOT_ENGINE=openai requiere ambos campos. Nunca colocar claves en Git.
OPENAI_API_KEY=
OPENAI_BOT_MODEL=gpt-5.4-mini-2026-03-17
QUOTE_TTL_SECONDS=900
BOT_MAX_ATTEMPTS=5
